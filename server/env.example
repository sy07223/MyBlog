# 复制本文件为 server/.env 后修改，切勿把 .env 提交到 Git

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# 必改：至少 32 位随机字符串，用于签发管理后台 JWT
JWT_SECRET=change-me-to-a-long-random-secret

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=personal_blog

# 可选：RSS / sitemap 里的站点地址；不填则用请求 Host 推断
# PUBLIC_SITE_URL=https://your-domain.com

# 可选：留言敏感词，英文逗号或中文逗号分隔
# GUESTBOOK_BLOCKED_WORDS=

# 可选：反代时设为 1
# TRUST_PROXY=1
